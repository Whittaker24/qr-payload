# Copy this file to .streamlit/secrets.toml (gitignored) for local dev.
# On Streamlit Community Cloud, set the same keys in the app's
# Settings -> Secrets panel instead of committing a real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Login credentials for the app's gate — one entry per person who should
# have access. Add/remove people by editing this table; no signup flow.
[app_credentials]
jason = "change-me"
guest = "change-me-too"
